NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase modern API keys (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Gemini server-side only
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_VISION_PROVIDER=gemini
AI_TEXT_PROVIDER=gemini
AI_ALLOW_PAID_MODELS=false
AI_REQUESTS_PER_USER_PER_DAY=20
AI_ENABLE_RULE_BASED_FALLBACK=true

# Optional E2E overrides
PLAYWRIGHT_PORT=4173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
